{
  "name": "@allansli/react-barcode-febraban",
  "version": "2.0.2",
  "description": "React component for Brazilian boleto ITF barcodes (Interleaved 2 of 5 / Febraban). Encodes an even-length digit string for BarcodeInterleaved2of5. Not EAN, UPC, Code 128, or a linha digitável converter.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "src/index.d.ts",
  "source": "src/BarcodeFebraban.jsx",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/BarcodeFebraban.jsx",
    "src/index.d.ts"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "test": "jest tests"
  },
  "keywords": [
    "barcode",
    "itf",
    "interleaved-2-of-5",
    "interleaved 2 of 5",
    "febraban",
    "boleto",
    "linha-digitavel",
    "brazilian",
    "brazil",
    "react",
    "font-encoder",
    "codigo-de-barras"
  ],
  "author": "Allan Martins de Paula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allansli/angular-barcode-febraban.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/allansli/angular-barcode-febraban/issues"
  },
  "homepage": "https://github.com/allansli/angular-barcode-febraban/tree/master/packages/react#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "@allansli/barcode-febraban-core": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "rollup": "^4.64.0"
  }
}
