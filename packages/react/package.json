{
  "name": "@allansli/react-barcode-febraban",
  "version": "1.0.0",
  "description": "React component that encodes even-length digit strings for BarcodeInterleaved2of5.ttf",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "src/index.d.ts",
  "source": "src/BarcodeFebraban.jsx",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/BarcodeFebraban.jsx",
    "src/index.d.ts"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "test": "jest tests"
  },
  "keywords": [
    "barcode",
    "react",
    "itf",
    "interleaved-2-of-5",
    "font-encoder",
    "boleto",
    "codigo-de-barras"
  ],
  "author": "Allan Martins de Paula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allansli/angular-barcode-febraban.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/allansli/angular-barcode-febraban/issues"
  },
  "homepage": "https://github.com/allansli/angular-barcode-febraban/tree/master/packages/react#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "@allansli/barcode-febraban-core": "^1.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "rollup": "^4.0.0"
  }
}
