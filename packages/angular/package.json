    "linha-digitavel",
    "brazilian",
    "brazil",
    "angular",
    "ng",
    "font-encoder",
    "codigo-de-barras"
  ],
  "author": "Allan Martins de Paula",
  "license": "MIT",
  "repository": {
    "type": "git",
