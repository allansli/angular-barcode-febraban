{
  "name": "@allansli/vue-barcode-febraban",
  "version": "1.0.0",
  "description": "Vue 3 component that encodes even-length digit strings for BarcodeInterleaved2of5.ttf",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/BarcodeFebraban.vue",
    "src/index.js",
    "src/index.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run"
  },
  "keywords": [
    "barcode",
    "vue",
    "vue3",
    "itf",
    "interleaved-2-of-5",
    "font-encoder",
    "boleto",
    "codigo-de-barras"
  ],
  "author": "Allan Martins de Paula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allansli/angular-barcode-febraban.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/allansli/angular-barcode-febraban/issues"
  },
  "homepage": "https://github.com/allansli/angular-barcode-febraban/tree/master/packages/vue#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@allansli/barcode-febraban-core": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "vue": "^3.4.0"
  }
}
