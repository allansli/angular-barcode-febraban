{
  "name": "@allansli/vue-barcode-febraban",
  "version": "1.0.0",
  "description": "Vue 3 component to render ITF (Interleaved 2 of 5) barcodes — FEBRABAN Brazilian banking standard",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite"
  },
  "keywords": [
    "barcode",
    "vue",
    "vue3",
    "febraban",
    "interleaved-2-of-5",
    "boleto",
    "itf",
    "codigo-de-barras"
  ],
  "author": "Allan Martins de Paula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allansli/angular-barcode-febraban.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/allansli/angular-barcode-febraban/issues"
  },
  "homepage": "https://github.com/allansli/angular-barcode-febraban/tree/master/packages/vue#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@allansli/barcode-febraban-core": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0"
  }
}
